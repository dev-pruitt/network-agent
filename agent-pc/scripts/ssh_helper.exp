#!/usr/bin/expect -f
set timeout 15
set ip [lindex $argv 0]
set pass [lindex $argv 1]
set cmd [lindex $argv 2]

spawn ssh -o StrictHostKeyChecking=no -o HostKeyAlgorithms=+ssh-rsa -o PubkeyAcceptedKeyTypes=+ssh-rsa root@$ip "$cmd"
expect {
    "password:" { send "$pass\r" }
    timeout { puts "TIMEOUT"; exit 1 }
}
expect eof
